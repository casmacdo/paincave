# Copy to apps/worker/.dev.vars for local Cloudflare Worker development (NEVER commit .dev.vars)

# Worker authentication secrets (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=replace-with-32-byte-hex
SESSION_SIGNING_SECRET=replace-with-32-byte-hex
BRIDGE_DEVICE_TOKEN=replace-with-32-byte-hex
MCP_BEARER_TOKEN=replace-with-32-byte-hex

# Google OAuth 2.0 Web Application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:8787
ALLOWED_USER_EMAILS=

# Strava personal API app credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Local trainer-bridge configuration (env vars for crates/trainer-bridge)
PAINCAVE_API_URL=http://127.0.0.1:8787
PAINCAVE_BRIDGE_PORT=8765
PAINCAVE_BRIDGE_TOKEN=replace-with-32-byte-hex
PAINCAVE_DATA_DIR=./.paincave-local
